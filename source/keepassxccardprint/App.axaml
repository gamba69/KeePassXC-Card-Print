<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KeePassXCCardPrint.App">
  <!-- Custom application palette, distinct from the default Fluent colors. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary x:Key="Light">
        <SolidColorBrush x:Key="KpWindowBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="KpSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="KpTextBrush" Color="#182B40" />
        <SolidColorBrush x:Key="KpSubtleBrush" Color="#64788D" />
        <SolidColorBrush x:Key="KpBorderBrush" Color="#DBE4EE" />
        <!-- Dedicated, deliberately visible window frame: not a form-field separator. -->
        <SolidColorBrush x:Key="KpFrameBrush" Color="#C9D7E6" />
        <SolidColorBrush x:Key="KpTabWindowBrush" Color="#f3f4f7" />
        <SolidColorBrush x:Key="KpTabSurfaceBrush" Color="#ffffff" />
        <SolidColorBrush x:Key="KpTabTextBrush" Color="#1c2730" />
        <SolidColorBrush x:Key="KpTabBorderBrush" Color="#ced4dc" />
        <SolidColorBrush x:Key="KpSelectedBrush" Color="#dbeafe" />
        <SolidColorBrush x:Key="KpSelectedTextBrush" Color="#172b45" />
        <SolidColorBrush x:Key="KpButtonBrush" Color="#e8edf4" />
        <SolidColorBrush x:Key="KpInputBrush" Color="#ffffff" />
        <SolidColorBrush x:Key="KpCanvasBrush" Color="#c8cdd3" />
        <SolidColorBrush x:Key="KpAccentBrush" Color="#2b68b6" />
        <SolidColorBrush x:Key="KpErrorBrush" Color="#ba3232" />
        <SolidColorBrush x:Key="KpDangerButtonBrush" Color="#b42318" />
        <SolidColorBrush x:Key="KpDangerButtonHoverBrush" Color="#cf3026" />
        <SolidColorBrush x:Key="KpDangerButtonPressedBrush" Color="#922016" />
        <SolidColorBrush x:Key="KpDangerButtonTextBrush" Color="#ffffff" />
        <SolidColorBrush x:Key="KpRowHoverBrush" Color="#e6f0fc" />
        <SolidColorBrush x:Key="KpStripeBrush" Color="#f3f7fc" />
        <SolidColorBrush x:Key="KpZebraBrush" Color="#eef3f8" />
        <SolidColorBrush x:Key="KpRowMarkedBrush" Color="#cce1f8" />
        <SolidColorBrush x:Key="KpRowMarkedHoverBrush" Color="#b6d6f8" />
        <SolidColorBrush x:Key="KpHeaderBrush" Color="#E9F1F8" />
        <SolidColorBrush x:Key="KpHeaderBorderBrush" Color="#d7dde5" />
        <SolidColorBrush x:Key="KpHeaderTextBrush" Color="#182B40" />
        <SolidColorBrush x:Key="KpHeaderSubtleBrush" Color="#556E85" />
        <SolidColorBrush x:Key="KpHeaderIconBrush" Color="#252f39" />
        <SolidColorBrush x:Key="KpFooterBrush" Color="#EAF0F7" />
        <SolidColorBrush x:Key="KpFooterTextBrush" Color="#64788D" />
        <SolidColorBrush x:Key="KpFooterMetaBrush" Color="#64788D" />
        <!-- A PopupBorder in the Fluent template uses LOCAL DynamicResource values.
             Override those resource keys; a Border style setter cannot win. -->
        <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#ffffff" />
        <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#ced4dc" />
        <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#ffffff" />
        <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#ced4dc" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#ffffff" />
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#ced4dc" />
      </ResourceDictionary>
      <ResourceDictionary x:Key="Dark">
        <SolidColorBrush x:Key="KpWindowBrush" Color="#101821" />
        <SolidColorBrush x:Key="KpSurfaceBrush" Color="#182633" />
        <SolidColorBrush x:Key="KpTextBrush" Color="#E9F0F9" />
        <SolidColorBrush x:Key="KpSubtleBrush" Color="#A2B6C9" />
        <SolidColorBrush x:Key="KpBorderBrush" Color="#35495C" />
        <SolidColorBrush x:Key="KpFrameBrush" Color="#2A3C4E" />
        <SolidColorBrush x:Key="KpTabWindowBrush" Color="#081524" />
        <SolidColorBrush x:Key="KpTabSurfaceBrush" Color="#182b3f" />
        <SolidColorBrush x:Key="KpTabTextBrush" Color="#eef4fb" />
        <SolidColorBrush x:Key="KpTabBorderBrush" Color="#31475f" />
        <SolidColorBrush x:Key="KpSelectedBrush" Color="#213347" />
        <SolidColorBrush x:Key="KpSelectedTextBrush" Color="#ffffff" />
        <SolidColorBrush x:Key="KpButtonBrush" Color="#20384e" />
        <SolidColorBrush x:Key="KpInputBrush" Color="#13273b" />
        <SolidColorBrush x:Key="KpCanvasBrush" Color="#06111c" />
        <SolidColorBrush x:Key="KpAccentBrush" Color="#567A9C" />
        <SolidColorBrush x:Key="KpErrorBrush" Color="#ff8585" />
        <SolidColorBrush x:Key="KpDangerButtonBrush" Color="#b42318" />
        <SolidColorBrush x:Key="KpDangerButtonHoverBrush" Color="#cd3329" />
        <SolidColorBrush x:Key="KpDangerButtonPressedBrush" Color="#961f17" />
        <SolidColorBrush x:Key="KpDangerButtonTextBrush" Color="#ffffff" />
        <SolidColorBrush x:Key="KpRowHoverBrush" Color="#23384d" />
        <SolidColorBrush x:Key="KpStripeBrush" Color="#1f3448" />
        <SolidColorBrush x:Key="KpZebraBrush" Color="#1d3246" />
        <SolidColorBrush x:Key="KpRowMarkedBrush" Color="#264664" />
        <SolidColorBrush x:Key="KpRowMarkedHoverBrush" Color="#315673" />
        <SolidColorBrush x:Key="KpHeaderBrush" Color="#172738" />
        <SolidColorBrush x:Key="KpHeaderBorderBrush" Color="#27425d" />
        <SolidColorBrush x:Key="KpHeaderTextBrush" Color="#ffffff" />
        <SolidColorBrush x:Key="KpHeaderSubtleBrush" Color="#AEC8DF" />
        <SolidColorBrush x:Key="KpHeaderIconBrush" Color="#ffffff" />
        <SolidColorBrush x:Key="KpFooterBrush" Color="#172432" />
        <SolidColorBrush x:Key="KpFooterTextBrush" Color="#A2B6C9" />
        <SolidColorBrush x:Key="KpFooterMetaBrush" Color="#A2B6C9" />
        <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#13273b" />
        <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#31475f" />
        <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#13273b" />
        <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#31475f" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#13273b" />
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#31475f" />
      </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <!-- Avalonia 12 Fluent ComboBox.xaml uses 0,4,0,4 for this exact key.
           Remove BOTH bands at the resource level, not via /template/ Styles:
           ItemsPresenter.Margin is a local DynamicResource set by Fluent. -->
      <Thickness x:Key="ComboBoxDropdownContentMargin">0</Thickness>
      <Thickness x:Key="ComboBoxDropdownBorderPadding">0</Thickness>
      <Thickness x:Key="ComboBoxDropdownBorderThickness">1</Thickness>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- Fluent's template/popup colors must be configured as well as our app brushes. -->
    <FluentTheme DensityStyle="Compact">
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#2b68b6" RegionColor="#F4F7FB"
                               BaseHigh="#182B40" BaseMedium="#64788D"
                               ChromeLow="#e8edf4" ChromeMedium="#ced4dc" />
        <ColorPaletteResources x:Key="Dark" Accent="#567A9C" RegionColor="#101821"
                               BaseHigh="#E9F0F9" BaseMedium="#A2B6C9"
                               ChromeLow="#20384e" ChromeMedium="#31475f" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://KeePassXCCardPrint/styles/Compact.axaml" />
  </Application.Styles>
</Application>
