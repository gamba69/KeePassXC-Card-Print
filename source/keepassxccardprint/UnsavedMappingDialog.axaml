<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fi="using:FluentIcons.Avalonia"
        x:Class="KeePassXCCardPrint.UnsavedMappingDialog"
        WindowDecorations="Full" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Width="490"
        SizeToContent="Height" MinHeight="185" MaxHeight="360"
        Background="{DynamicResource KpWindowBrush}">
  <!-- Same native frame, theme card and button footer as print confirmations. -->
  <DockPanel LastChildFill="True">
    <Border Classes="app-footer" DockPanel.Dock="Bottom">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="SaveButton" Click="OnSave" Height="26" MinWidth="0" Padding="8,2"><StackPanel Orientation="Horizontal" Spacing="6"><fi:FluentIcon Icon="Save" IconVariant="Regular" IconSize="Size20" Width="14" Height="14" FontSize="14" Foreground="{DynamicResource KpTextBrush}"/><TextBlock x:Name="SaveText" VerticalAlignment="Center"/></StackPanel></Button>
        <Button x:Name="DiscardButton" Click="OnDiscard" Height="26" MinWidth="0" Padding="8,2"><StackPanel Orientation="Horizontal" Spacing="6"><fi:FluentIcon Icon="ArrowSync" IconVariant="Regular" IconSize="Size20" Width="14" Height="14" FontSize="14" Foreground="{DynamicResource KpTextBrush}"/><TextBlock x:Name="DiscardText" VerticalAlignment="Center"/></StackPanel></Button>
        <Button x:Name="CancelButton" Click="OnCancel" Height="26" MinWidth="0" Padding="8,2"><StackPanel Orientation="Horizontal" Spacing="6"><fi:FluentIcon Icon="DismissCircle" IconVariant="Regular" IconSize="Size20" Width="16" Height="16" FontSize="16" Foreground="{DynamicResource KpTextBrush}"/><TextBlock x:Name="CancelText" VerticalAlignment="Center"/></StackPanel></Button>
      </StackPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="0">
    <Border Classes="settings-card" Margin="12" Padding="12">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <fi:FluentIcon Icon="QuestionCircle" IconSize="Size20" IconVariant="Regular"
                         Width="20" Height="20" FontSize="20" Foreground="{DynamicResource KpAccentBrush}"/>
          <TextBlock x:Name="DialogHeading" Classes="section-heading" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Height="1" Background="{DynamicResource KpBorderBrush}"/>
        <TextBlock x:Name="DialogQuestion" TextWrapping="Wrap" FontSize="13"/>
      </StackPanel>
    </Border>
    </ScrollViewer>
  </DockPanel>
</Window>
