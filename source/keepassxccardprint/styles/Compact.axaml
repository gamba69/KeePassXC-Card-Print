<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- One compact desktop style for both palette variants; DynamicResource keeps
       every surface synchronized when Light -> Dark -> Light is selected. -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource KpWindowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextBrush}" />
  </Style>
  <!-- Shared rounded panels on Source and Mapping, matching Appearance / Duplex.
       Dynamic brushes ensure theme switching does not leave light surfaces. -->
  <!-- Seamless, full-width app chrome; content owns its margin, not the footer. -->
  <Style Selector="Border.app-header">
    <Setter Property="Background" Value="{DynamicResource KpHeaderBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="24,10,12,10" />
  </Style>
  <Style Selector="Border.app-footer">
    <Setter Property="Background" Value="{DynamicResource KpFooterBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="17,9" />
  </Style>
  <Style Selector="TextBlock.app-title">
    <Setter Property="FontSize" Value="23" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource KpHeaderTextBrush}" />
  </Style>
  <Style Selector="TextBlock.app-subtitle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource KpHeaderSubtleBrush}" />
  </Style>
  <Style Selector="TextBlock.chrome-label">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource KpHeaderTextBrush}" />
  </Style>
  <Style Selector="TextBlock.app-footer-text">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource KpFooterTextBrush}" />
  </Style>
  <Style Selector="TextBlock.app-footer-meta">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource KpFooterMetaBrush}" />
  </Style>
  <!-- One theme-aware state surface over the preview viewport, not the sheet. -->
  <Style Selector="Border.preview-state">
    <Setter Property="Background" Value="{DynamicResource KpSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="MaxWidth" Value="360"/>
  </Style>
  <Style Selector="Border.settings-card">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource KpSurfaceBrush}" />
    <Setter Property="Padding" Value="9" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource KpTextBrush}" />
  </Style>
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource KpButtonBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextBrush}" />
  </Style>
  <!-- Security-sensitive confirmation: an explicit red button in both themes,
       including Fluent's ContentPresenter hover/pressed states. -->
  <Style Selector="Button.danger-action">
    <Setter Property="Background" Value="{DynamicResource KpDangerButtonBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpDangerButtonTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpDangerButtonBrush}" />
  </Style>
  <Style Selector="Button.danger-action /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpDangerButtonBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpDangerButtonTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpDangerButtonBrush}" />
  </Style>
  <Style Selector="Button.danger-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpDangerButtonHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpDangerButtonHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpDangerButtonTextBrush}" />
  </Style>
  <Style Selector="Button.danger-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpDangerButtonPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpDangerButtonPressedBrush}" />
  </Style>
  <!-- The Fluent disabled-state template uses its own grey resources, even if
       Button.Background is themed. Override the template presenter in *both*
       themes so disabled Save/Print/etc keep the same app surface. -->
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpButtonBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpSubtleBrush}" />
  </Style>
  <!-- Visually mute the icon and label without greying out the themed border. -->
  <Style Selector="Button:disabled StackPanel">
    <Setter Property="Opacity" Value="0.63" />
  </Style>
  <!-- Popup surfaces must follow the application palette; Avalonia's default
       Fluent flyouts otherwise remain graphite-gray in our navy theme. -->
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource KpSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource KpSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource KpTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource KpSurfaceBrush}" />
  </Style>
  <Style Selector="MenuItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource KpRowHoverBrush}" />
  </Style>
  <!-- Fluent glyphs are square boxes, centered by the button and not by a
       text baseline. Active preview side has a clear accent background. -->
  <!-- Preview tools are true 29-DIP vector buttons, compact in either dock. -->
  <Style Selector="Button.preview-tool">
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource KpTextBrush}"/>
    <Setter Property="Width" Value="29"/>
    <Setter Property="Height" Value="29"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="3"/>
  </Style>
  <Style Selector="ToggleButton.preview-tool">
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource KpTextBrush}"/>
    <Setter Property="Width" Value="29"/>
    <Setter Property="Height" Value="29"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="3"/>
  </Style>
  <Style Selector="ToggleButton.preview-tool:checked">
    <Setter Property="Background" Value="{DynamicResource KpSelectedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource KpAccentBrush}"/>
  </Style>
  <!-- Compact preset filters, aligned with the search field (no new toolbar row).
       Explicit Fluent presenter states prevent checked toggles from using a
       foreign gray background in either light or dark palette. -->
  <Style Selector="ToggleButton.record-quick-filter">
    <Setter Property="Width" Value="29"/>
    <Setter Property="Height" Value="29"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource KpButtonBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderBrush}"/>
    <Setter Property="CornerRadius" Value="2"/>
  </Style>
  <Style Selector="ToggleButton.record-quick-filter:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpSelectedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderBrush}"/>
  </Style>
  <Style Selector="ToggleButton.record-quick-filter:checked">
    <Setter Property="Background" Value="{DynamicResource KpSelectedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource KpAccentBrush}"/>
  </Style>
  <Style Selector="ToggleButton.record-quick-filter:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpSelectedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource KpAccentBrush}"/>
  </Style>
  <Style Selector="ToggleButton.record-quick-filter:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpSelectedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource KpAccentBrush}"/>
  </Style>
  <Style Selector="Button.record-quick-action">
    <Setter Property="Width" Value="29"/>
    <Setter Property="Height" Value="29"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CornerRadius" Value="2"/>
  </Style>
  <!-- Tiny steppers are exactly 13 DIP each; global button chrome must not
       expand either button or shift its vector arrow within the field row. -->
  <Style Selector="Button.spinner-arrow">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="1" />
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource KpSelectedBrush}" />
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="Background" Value="{DynamicResource KpSelectedBrush}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource KpInputBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextBrush}" />
  </Style>
  <!-- Mapping validation: never commit an incomplete number to the working model. -->
  <Style Selector="TextBox.invalid">
    <Setter Property="BorderBrush" Value="{DynamicResource KpErrorBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="TextBox.invalid:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource KpErrorBrush}" />
  </Style>
  <Style Selector="TextBlock.mapping-error">
    <Setter Property="Foreground" Value="{DynamicResource KpErrorBrush}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Button.mapping-save">
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource KpAccentBrush}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource KpInputBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextBrush}" />
  </Style>
  <Style Selector="ComboBox:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource KpAccentBrush}" />
  </Style>
  <!-- Fluent PopupBorder and ItemsPresenter have LOCAL DynamicResource values.
       Their spacing and popup colors are overridden in App.axaml with the
       exact ComboBoxDropDown... resource keys (not style setters). -->
  <Style Selector="ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpInputBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpRowHoverBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpSelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpSelectedTextBrush}" />
  </Style>
  <Style Selector="ComboBox.header-select">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="7,5" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="ComboBoxItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource KpInputBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource KpSelectedBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource KpSelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpSelectedTextBrush}" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextBrush}" />
  </Style>
  <Style Selector="TabControl">
    <Setter Property="Background" Value="{DynamicResource KpTabWindowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTabTextBrush}" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="MinHeight" Value="29" />
    <Setter Property="Padding" Value="11,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource KpButtonBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTabTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpTabBorderBrush}" />
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Background" Value="{DynamicResource KpTabSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTabTextBrush}" />
  </Style>
  <!-- Avalonia 12 Fluent TabItem template draws a thin selected underline.
       Hide its PART_SelectedPipe in every state, keeping the compact
       selected-tab background as the sole selection indicator. -->
  <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Height" Value="0" />
  </Style>
  <Style Selector="TabItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource KpSelectedBrush}" />
  </Style>
  <!-- Second-level section tabs: wrap into clean rows instead of hiding
       groups in a drop-down or creating a horizontal scrollbar. -->
  <Style Selector="ListBox.category-tabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.category-tabs ListBoxItem">
    <Setter Property="MinHeight" Value="29" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource KpButtonBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextBrush}" />
  </Style>
  <Style Selector="ListBox.category-tabs ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource KpRowHoverBrush}" />
  </Style>
  <Style Selector="ListBox.category-tabs ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource KpSelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpSelectedTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpAccentBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
  </Style>
  <Style Selector="ListBox.category-tabs ListBoxItem:selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource KpSelectedBrush}" />
  </Style>
  <!-- Single semantic heading tier throughout the app (main panels, preview,
       popup settings, and dialogs). Use Classes="section-heading" instead of
       hard-coding FontSize on individual headings. The product/brand title is
       intentionally a distinct tier. -->
  <Style Selector="TextBlock.section-heading">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource KpSubtleBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- Dense entry list: hover, print choice, focused row all have separate cues. -->
  <Style Selector="Border.vault-row">
    <Setter Property="Background" Value="{DynamicResource KpSurfaceBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderBrush}" />
  </Style>
  <Style Selector="Border.vault-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource KpRowHoverBrush}" />
  </Style>
  <Style Selector="Border.vault-row.print-selected">
    <Setter Property="Background" Value="{DynamicResource KpRowMarkedBrush}" />
  </Style>
  <Style Selector="Border.vault-row.print-selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource KpRowMarkedHoverBrush}" />
  </Style>
  <Style Selector="Border.vault-row:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource KpAccentBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,1" />
  </Style>
  <!-- The domain editor must not inherit Avalonia Fluent's graphite ListBox
       background. Restrict these item states to this dialog's list only. -->
  <Style Selector="ListBox.domain-prefix-list">
    <Setter Property="Background" Value="{DynamicResource KpInputBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderBrush}" />
  </Style>
  <Style Selector="ListBox.domain-prefix-list ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextBrush}" />
    <Setter Property="Padding" Value="5,3" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="ListBox.domain-prefix-list ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource KpRowHoverBrush}" />
  </Style>
  <Style Selector="ListBox.domain-prefix-list ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource KpSelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpSelectedTextBrush}" />
  </Style>
  <Style Selector="ListBox.domain-prefix-list ListBoxItem:selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource KpRowMarkedHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpSelectedTextBrush}" />
  </Style>
  <Style Selector="ListBox.mapping-list ListBoxItem">
    <Setter Property="MinHeight" Value="25" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="{DynamicResource KpSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextBrush}" />
  </Style>
  <Style Selector="ListBox.mapping-list ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource KpRowHoverBrush}" />
  </Style>
  <Style Selector="ListBox.mapping-list ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource KpRowMarkedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextBrush}" />
  </Style>
  <Style Selector="ListBox.mapping-list ListBoxItem:selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource KpRowMarkedHoverBrush}" />
  </Style>
  <Style Selector="Border.table-row">
    <Setter Property="Height" Value="24" />
    <Setter Property="Background" Value="{DynamicResource KpSurfaceBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderBrush}" />
  </Style>
  <Style Selector="Border.table-header">
    <Setter Property="Height" Value="27" />
    <Setter Property="Background" Value="{DynamicResource KpButtonBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderBrush}" />
  </Style>
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource KpBorderBrush}" />
  </Style>
</Styles>
