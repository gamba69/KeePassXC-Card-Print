<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fi="using:FluentIcons.Avalonia"
        x:Class="KeePassXCCardPrint.StorageSwitchDialog"
        WindowDecorations="Full" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Width="650"
        SizeToContent="Height" MinHeight="360" MaxHeight="690"
        Background="{DynamicResource KpWindowBrush}">
  <DockPanel LastChildFill="True">
    <Border Classes="app-footer" DockPanel.Dock="Bottom">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Click="OnCancel" Height="27" MinWidth="0" Padding="10,3">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <fi:FluentIcon Icon="DismissCircle" IconVariant="Regular" IconSize="Size20" Width="16" Height="16" FontSize="16" Foreground="{DynamicResource KpTextBrush}"/>
            <TextBlock x:Name="CancelText" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="12" Spacing="9">
        <Border Classes="settings-card" Padding="12">
          <StackPanel Spacing="9">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <fi:FluentIcon Icon="QuestionCircle" IconSize="Size20" IconVariant="Regular"
                             Width="20" Height="20" FontSize="20"
                             Foreground="{DynamicResource KpAccentBrush}"/>
              <TextBlock x:Name="DialogHeading" Classes="section-heading" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource KpBorderBrush}"/>
            <TextBlock x:Name="DialogIntro" TextWrapping="Wrap" FontSize="13"/>
          </StackPanel>
        </Border>
        <Border Classes="settings-card" Padding="11">
          <StackPanel Spacing="7">
            <TextBlock x:Name="YesHeading" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
            <TextBlock x:Name="YesRoute" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock x:Name="YesExplanation" FontSize="12" TextWrapping="Wrap"/>
            <Button x:Name="YesButton" Click="OnYes" HorizontalAlignment="Right" MinWidth="150"
                    Height="29" Padding="9,3">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <fi:FluentIcon Icon="DocumentCopy" IconVariant="Regular" IconSize="Size20"
                               Width="14" Height="14" FontSize="14" Foreground="{DynamicResource KpTextBrush}"/>
                <TextBlock x:Name="YesText" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
        <Border Classes="settings-card" Padding="11">
          <StackPanel Spacing="7">
            <TextBlock x:Name="NoHeading" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
            <TextBlock x:Name="NoRoute" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock x:Name="NoExplanation" FontSize="12" TextWrapping="Wrap"/>
            <Button x:Name="NoButton" Click="OnNo" HorizontalAlignment="Right" MinWidth="150"
                    Height="29" Padding="9,3">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <fi:FluentIcon Icon="ArrowSync" IconVariant="Regular" IconSize="Size20"
                               Width="14" Height="14" FontSize="14" Foreground="{DynamicResource KpTextBrush}"/>
                <TextBlock x:Name="NoText" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
