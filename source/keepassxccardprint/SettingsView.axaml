<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeePassXCCardPrint.ViewModels"
             xmlns:fi="using:FluentIcons.Avalonia"
             x:Class="KeePassXCCardPrint.SettingsView"
             x:DataType="vm:ShellViewModel"
             Background="{DynamicResource KpSurfaceBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="0">
    <StackPanel Margin="11" Spacing="10">
      <Border Classes="settings-card" Padding="11">
        <StackPanel Spacing="8">
          <TextBlock x:Name="StorageTitle" Classes="section-heading" Text="Хранение конфигурации"/>
          <TextBlock x:Name="StorageCaption" Text="Способ хранения"/>
          <ComboBox x:Name="StoragePicker" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding StorageOptions}" SelectedItem="{Binding SelectedStorage, Mode=OneWay}"
                    SelectionChanged="OnStorageChanged">
            <ComboBox.Styles>
              <Style Selector="ComboBoxItem" x:DataType="vm:OptionItem">
                <Setter Property="IsEnabled" Value="{CompiledBinding IsEnabled}"/>
              </Style>
            </ComboBox.Styles>
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:OptionItem"><TextBlock Text="{Binding Label}"/></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock x:Name="CloudUnavailableReason" FontSize="11" TextWrapping="Wrap" IsVisible="False"/>
          <TextBlock x:Name="ProviderCaption" Text="Облачный провайдер"/>
          <ComboBox x:Name="ProviderPicker" HorizontalAlignment="Stretch"
                    SelectionChanged="OnProviderChanged"/>
          <TextBlock x:Name="FolderCaption" Text="Папка в облаке"/>
          <TextBox x:Name="FolderBox" PlaceholderText="KeePassXC-Card-Print"/>
          <TextBlock x:Name="EndpointCaption" Text="Адрес сервера (WebDAV / S3 / R2)"/>
          <TextBox x:Name="EndpointBox" PlaceholderText="https://"/>
          <TextBlock x:Name="BucketCaption" Text="Bucket (S3 / R2)"/>
          <TextBox x:Name="BucketBox"/>
          <TextBlock x:Name="RegionCaption" Text="Region (S3 / R2)"/>
          <TextBox x:Name="RegionBox"/>
          <CheckBox x:Name="AdvancedGoogleCheck" Content="Дополнительные параметры Google OAuth"/>
          <TextBlock x:Name="ClientIdCaption" Text="Google OAuth Client ID"/>
          <TextBox x:Name="ClientIdBox"/>
          <TextBlock x:Name="ProtonCaption" Text="Путь к Proton CLI"/>
          <TextBox x:Name="ProtonBox" PlaceholderText="Автоматический поиск"/>
          <Button x:Name="BrowseProtonButton" HorizontalAlignment="Left" Click="OnBrowseProton">
            <StackPanel Orientation="Horizontal" Spacing="6"><fi:FluentIcon Icon="FolderOpen" IconVariant="Regular" IconSize="Size20" Width="18" Height="18" FontSize="18" VerticalAlignment="Center"/><TextBlock x:Name="BrowseProtonLabel" Text="Обзор…" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <CheckBox x:Name="AutoProtonCheck" Content="Проверять обновления Proton CLI автоматически"/>
          <TextBlock x:Name="ProtonStatus" TextWrapping="Wrap" FontSize="11"/>
          <WrapPanel x:Name="ProtonActions" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
            <Button x:Name="CheckProtonButton" Click="OnCheckProton"><StackPanel Orientation="Horizontal" Spacing="6"><fi:FluentIcon Icon="ArrowSync" IconVariant="Regular" IconSize="Size20" Width="18" Height="18" FontSize="18" VerticalAlignment="Center"/><TextBlock x:Name="CheckProtonLabel" Text="Проверить версию" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="InstallProtonButton" Click="OnInstallProton"><StackPanel Orientation="Horizontal" Spacing="6"><fi:FluentIcon Icon="ArrowDownload" IconVariant="Regular" IconSize="Size20" Width="18" Height="18" FontSize="18" VerticalAlignment="Center"/><TextBlock x:Name="InstallProtonLabel" Text="Скачать / обновить Proton CLI" VerticalAlignment="Center"/></StackPanel></Button>
          </WrapPanel>
          <TextBlock x:Name="UsernameCaption" Text="Имя пользователя / Access Key"/>
          <TextBox x:Name="UsernameBox"/>
          <TextBlock x:Name="SecretCaption" Text="Пароль / Secret Key / OAuth Client Secret (если изменяется)" TextWrapping="Wrap"/>
          <TextBox x:Name="SecretBox" PasswordChar="●"/>
          <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
            <Button x:Name="SaveCloudButton" Click="OnSaveConnection">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <fi:FluentIcon Icon="Save" IconVariant="Regular" IconSize="Size20" Width="18" Height="18" FontSize="18" VerticalAlignment="Center"/>
                <TextBlock x:Name="SaveCloudButtonLabel" Text="Сохранить подключение" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="LoginCloudButton" Click="OnAuthenticate">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <fi:FluentIcon Icon="Key" IconVariant="Regular" IconSize="Size20" Width="18" Height="18" FontSize="18" VerticalAlignment="Center"/>
                <TextBlock x:Name="LoginCloudButtonLabel" Text="Авторизоваться" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="TestCloudButton" Click="OnTestConnection">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <fi:FluentIcon Icon="CheckmarkCircle" IconVariant="Regular" IconSize="Size20" Width="18" Height="18" FontSize="18" VerticalAlignment="Center"/>
                <TextBlock x:Name="TestCloudButtonLabel" Text="Проверить" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="SyncCloudButton" Click="OnSyncNow">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <fi:FluentIcon Icon="ArrowSync" IconVariant="Regular" IconSize="Size20" Width="18" Height="18" FontSize="18" VerticalAlignment="Center"/>
                <TextBlock x:Name="SyncCloudButtonLabel" Text="Синхронизировать сейчас" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </WrapPanel>
          <Border x:Name="CloudActivity" Classes="settings-card" Padding="10,9" IsVisible="False">
            <StackPanel Spacing="7">
              <TextBlock x:Name="CloudActivityTitle" FontWeight="SemiBold" FontSize="12"
                         Text="Облачная операция" TextWrapping="Wrap"/>
              <!-- Stage position only: no sweeping animation or fabricated byte progress. -->
              <ProgressBar x:Name="CloudActivityBar" Height="4" Minimum="0" Maximum="100"
                           Value="0" Opacity="0.55"/>
              <TextBlock x:Name="CloudActivityStep" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Button x:Name="CloudDestinationButton" IsVisible="False" HorizontalAlignment="Left" Click="OnConfirmDestination">
            <StackPanel Orientation="Horizontal" Spacing="6"><fi:FluentIcon Icon="CloudCheckmark" IconVariant="Regular" IconSize="Size20" Width="18" Height="18" FontSize="18" VerticalAlignment="Center"/><TextBlock x:Name="CloudDestinationLabel" Text="Подтвердить новое облачное хранилище" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <Button x:Name="RecoverMappingButton" IsVisible="False" HorizontalAlignment="Left" Click="OnRecoverMapping">
            <StackPanel Orientation="Horizontal" Spacing="6"><fi:FluentIcon Icon="ArrowSync" IconVariant="Regular" IconSize="Size20" Width="18" Height="18" FontSize="18" VerticalAlignment="Center"/><TextBlock x:Name="RecoverMappingLabel" Text="Восстановить маппинг…" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <TextBlock x:Name="CloudStatus" TextWrapping="Wrap" FontSize="11"/>
          <TextBlock x:Name="LastSync" FontSize="11" TextWrapping="Wrap"/>
          <TextBlock x:Name="CloudOperationStatus" FontSize="11" TextWrapping="Wrap" IsVisible="False"/>
        </StackPanel>
      </Border>
      <Border Classes="settings-card" Padding="11">
        <StackPanel Spacing="8">
          <TextBlock x:Name="UpdatesCaption" Classes="section-heading" Text="Обновления программы"/>
          <CheckBox x:Name="AutoCheck" Content="Проверять обновления автоматически"/>
          <CheckBox x:Name="AutoDownload" Content="Автоматически скачивать обновления"/>
          <TextBlock x:Name="InstallModeCaption" Text="Установка обновлений"/>
          <ComboBox x:Name="InstallMode" HorizontalAlignment="Stretch" SelectionChanged="OnInstallModeChanged"/>
        </StackPanel>
      </Border>
      <Border Classes="settings-card" Padding="11">
        <StackPanel Spacing="8">
          <TextBlock x:Name="MaintenanceCaption" Classes="section-heading" Text="Обслуживание"/>
          <TextBlock x:Name="ResetHelp" TextWrapping="Wrap" FontSize="11"
                     Text="Сброс настроек с резервным копированием. История печати сохраняется, если явно не выбрать её удаление."/>
          <Button x:Name="ResetSettingsButton" HorizontalAlignment="Left" Click="OnResetSettings">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fi:FluentIcon Icon="Settings" IconVariant="Regular" IconSize="Size20" Width="18" Height="18" FontSize="18" VerticalAlignment="Center"/>
              <TextBlock x:Name="ResetSettingsButtonLabel" Text="Сбросить настройки…" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock x:Name="ResetStatus" TextWrapping="Wrap" FontSize="11" IsVisible="False"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
